# Postgres (em produção use a URL interna do Postgres criado no Coolify)
DATABASE_URL="postgresql://politica:politica@localhost:5432/politica?schema=public"

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"

# Anthropic (classificação das notícias + resumo diário). Sem a chave, usa regras por palavra-chave.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-haiku-5-5"

# Resend (e-mails de resumo diário e alertas)
RESEND_API_KEY=""
EMAIL_FROM="Política <politica@email.felipesobral.com>"

# URL pública do app (links nos e-mails)
APP_URL="http://localhost:3000"

# Protege /api/cron/* (opcional; o worker já agenda tudo sozinho)
CRON_SECRET="troque-por-um-segredo-longo"

# E-mails que viram administradores no primeiro acesso (separe por vírgula)
ADMIN_EMAILS="sobral@fruto.vc"

# Worker
INGEST_CRON="*/5 * * * *"   # confere a cada 5 min; o intervalo real é configurado em Admin → Robô
DIGEST_CRON="0 7 * * *"
TZ="America/Sao_Paulo"
