generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum Scope {
  MUNICIPAL
  ESTADUAL
  FEDERAL
}

enum ElectionOffice {
  PRESIDENTE
  GOVERNADOR
  SENADOR
  DEPUTADO
}

enum Branch {
  LEGISLATIVO
  EXECUTIVO
  JUDICIARIO
}

enum SourceCategory {
  PORTAL_NACIONAL
  JORNAL
  REVISTA
  TV
  RADIO
  AGENCIA_NOTICIAS
  ORGAO_OFICIAL
  PARTIDO
  REGIONAL
  BLOG_INDEPENDENTE
  OUTRO
}

enum NewsCategory {
  ECONOMIA
  SAUDE
  SEGURANCA
  EDUCACAO
  ELEICOES
  JUSTICA_CORRUPCAO
  INFRAESTRUTURA
  MEIO_AMBIENTE
  SOCIAL
  LEGISLATIVO
  ADMINISTRACAO
  INTERNACIONAL
  OUTROS
}

enum PoliticianRole {
  PRESIDENTE
  VICE_PRESIDENTE
  SENADOR
  DEPUTADO_FEDERAL
  GOVERNADOR
  VICE_GOVERNADOR
  DEPUTADO_ESTADUAL
  PREFEITO
  VICE_PREFEITO
  VEREADOR
}

model User {
  id               String   @id @default(cuid())
  clerkId          String   @unique
  email            String   @unique
  role             Role     @default(USER)
  name             String?
  uf               String?
  municipality     String?
  municipalityKey  String?
  dailyDigest      Boolean  @default(true)
  weeklyDigest     Boolean  @default(false)
  monthlyDigest    Boolean  @default(false)
  /// tiers de veículos considerados em cada resumo (ex.: "1,2"); padrão: todos
  digestTiersDaily   String @default("1,2,3")
  digestTiersWeekly  String @default("1,2,3")
  digestTiersMonthly String @default("1,2,3")
  alertEmails      Boolean  @default(true)
  /// sigla do partido do usuário (ex.: "PT"); "NONE" = respondeu que não tem partido; null = ainda não perguntado
  party            String?
  /// respostas e pesos do quiz de perfil político (ver lib/quiz)
  quizAnswers      Json?
  quizWeights      Json?
  quizAt           DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  follows   Follow[]
  favorites Favorite[]
  alerts    Alert[]
  digests   DigestLog[]
  chatTurns ChatTurn[]
}

model Source {
  id            String         @id @default(cuid())
  name          String         @unique
  homepage      String?
  category      SourceCategory @default(OUTRO)
  categoryKnown Boolean        @default(false)
  factCheck     Boolean        @default(false)
  /// 1 = grande alcance nacional/oficial, 2 = relevante (nacional menor, especializado, regional forte), 3 = demais; null = sem classificação
  tier          Int?
  /// quem definiu o tier: default (lista curada), ai (sugestão do Claude) ou admin
  tierBy        String?
  createdAt     DateTime       @default(now())

  articles Article[]
}

model Article {
  id              String       @id @default(cuid())
  url             String       @unique
  title           String
  description     String?
  imageUrl        String?
  publishedAt     DateTime
  scope           Scope
  uf              String?
  municipalityKey String?
  category        NewsCategory @default(OUTROS)
  branch          Branch?
  factCheck       Boolean      @default(false)
  summary         String?
  summaryKind     String?
  summaryAt       DateTime?
  directUrl       String?
  cargo           ElectionOffice?
  poll            Boolean      @default(false)
  clusterKey      String
  searchText      String       @default("")
  classified      Boolean      @default(false)
  /// siglas dos partidos citados (detectadas por regras, ver lib/parties.ts)
  parties         String[]     @default([])
  partiesChecked  Boolean      @default(false)
  origin          String?
  sourceId        String
  source          Source       @relation(fields: [sourceId], references: [id])
  createdAt       DateTime     @default(now())

  favorites    Favorite[]
  alertMatches AlertMatch[]

  @@index([scope, publishedAt(sort: Desc)])
  @@index([cargo, publishedAt(sort: Desc)])
  @@index([poll, publishedAt(sort: Desc)])
  @@index([factCheck, scope, publishedAt(sort: Desc)])
  @@index([scope, branch, publishedAt(sort: Desc)])
  @@index([scope, uf, publishedAt(sort: Desc)])
  @@index([scope, uf, municipalityKey, publishedAt(sort: Desc)])
  @@index([clusterKey])
  @@index([parties], type: Gin)
  @@index([classified])
  @@index([sourceId])
}

model Politician {
  id           String         @id @default(cuid())
  externalKey  String         @unique
  name         String
  ballotName   String?
  role         PoliticianRole
  uf           String?
  municipality String?
  municipalityKey String?
  party        String?
  photoUrl     String?
  email        String?
  phone        String?
  profileUrl   String?
  mandate      String?
  updatedAt    DateTime       @updatedAt

  follows Follow[]
  alerts  Alert[]

  @@index([role, uf])
  @@index([role, uf, municipalityKey])
}

model Follow {
  userId       String
  politicianId String
  createdAt    DateTime   @default(now())
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  politician   Politician @relation(fields: [politicianId], references: [id], onDelete: Cascade)

  @@id([userId, politicianId])
}

model Favorite {
  userId    String
  articleId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@id([userId, articleId])
}

model Alert {
  id           String      @id @default(cuid())
  userId       String
  keyword      String?
  politicianId String?
  active       Boolean     @default(true)
  createdAt    DateTime    @default(now())
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  politician   Politician? @relation(fields: [politicianId], references: [id], onDelete: Cascade)
  matches      AlertMatch[]

  @@index([userId])
}

model AlertMatch {
  id         String    @id @default(cuid())
  alertId    String
  articleId  String
  notifiedAt DateTime?
  createdAt  DateTime  @default(now())
  alert      Alert     @relation(fields: [alertId], references: [id], onDelete: Cascade)
  article    Article   @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([alertId, articleId])
  @@index([notifiedAt])
}

model DigestLog {
  id        String   @id @default(cuid())
  userId    String
  kind      String   @default("daily")
  day       String
  sentAt    DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, day])
}

model JobRun {
  id         String    @id @default(cuid())
  job        String
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  ok         Boolean   @default(false)
  info       String?

  @@index([job, startedAt(sort: Desc)])
}

model FeedSource {
  id              String         @id @default(cuid())
  name            String         @unique
  feedUrl         String         @unique
  homepage        String?
  category        SourceCategory @default(OUTRO)
  scope           Scope          @default(FEDERAL)
  branch          Branch?
  uf              String?
  municipality    String?
  municipalityKey String?
  active          Boolean        @default(true)
  factCheck       Boolean        @default(false)
  /// sigla do partido dono do site (as notícias desse feed ficam ligadas ao partido)
  party           String?
  lastOkAt        DateTime?
  lastError       String?
  lastCount       Int?
  createdAt       DateTime       @default(now())
}

model Setting {
  key   String @id
  value String
}

model Candidate {
  id          String         @id @default(cuid())
  externalKey String         @unique
  name        String
  ballotName  String
  number      Int?
  party       String?
  office      ElectionOffice
  uf          String?
  status      String
  updatedAt   DateTime       @updatedAt

  @@index([office, uf])
}

model Explanation {
  key       String   @id
  kind      String
  text      String
  createdAt DateTime @default(now())
}

/// uma mensagem do usuário ao agente de conversa (para o limite diário e o acompanhamento de custo)
model ChatTurn {
  id           String   @id @default(cuid())
  userId       String
  at           DateTime @default(now())
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  cachedTokens Int      @default(0)
  toolCalls    Int      @default(0)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, at])
}

model AiUsage {
  id           String   @id @default(cuid())
  at           DateTime @default(now())
  kind         String
  model        String
  inputTokens  Int
  outputTokens Int
  cachedTokens Int      @default(0)

  @@index([at])
}

/// Assuntos (clusterKey) que a IA já julgou "não é política": evita reclassificar os mesmos de outros veículos.
model RejectedCluster {
  clusterKey String   @id
  at         DateTime @default(now())
}

/// Cache dos dados de orçamento (Siconfi/Tesouro Nacional) por ente, ano e tipo.
model BudgetCache {
  key       String   @id
  data      Json
  fetchedAt DateTime @default(now())
}
